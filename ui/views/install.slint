import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";
import { FeaturedTape } from "../types.slint";
import { Field } from "../components/field.slint";
import { Panel } from "../components/panel.slint";
import { View } from "../components/view.slint";

export component InstallView inherits View {
    in property <[FeaturedTape]> featured;
    in property <bool> busy;
    in property <string> status;
    in property <string> progress;
    in property <float> progress-value;

    callback back();
    callback install(string, string, string, string);

    property <bool> tried;
    property <bool> ready: source.text != "" && !root.busy;

    // The page stays alive between visits, so start each visit with a clean form.
    changed shown => {
        if root.shown {
            source.text = "";
            name.text = "";
            branch.text = "";
            dir.text = "";
            root.tried = false;
        }
    }

    function submit() {
        if root.ready {
            root.tried = true;
            root.install(source.text, name.text, branch.text, dir.text);
        }
    }

    Panel {
        width: Math.min(480px, root.width - 48px);
        height: card.preferred-height + 56px;

        card := VerticalLayout {
            x: 28px;
            y: 28px;
            width: parent.width - 56px;
            alignment: start;
            spacing: 14px;

            Text {
                text: "add a tape";
                font-family: Theme.font-hand;
                font-size: 40px;
                font-weight: 700;
                color: Theme.text;
            }

            if root.featured.length > 0: VerticalLayout {
                spacing: 12px;

                Text {
                    text: "featured tapes";
                    font-family: Theme.font-hand;
                    font-size: 22px;
                    color: Theme.text-muted;
                }

                HorizontalLayout {
                    spacing: 12px;

                    for tape[i] in root.featured: pick := TouchArea {
                        property <bool> selected: source.text == tape.source && dir.text == tape.dir;
                        property <color> marker: Theme.marker(i);

                        height: 124px;
                        enabled: !root.busy;
                        mouse-cursor: root.busy ? MouseCursor.default : MouseCursor.pointer;
                        clicked => {
                            source.text = tape.source;
                            name.text = tape.name;
                            branch.text = "";
                            dir.text = tape.dir;
                        }

                        face := Rectangle {
                            y: pick.has-hover && !root.busy ? -3px : 0;
                            animate y { duration: 150ms; easing: ease-out; }

                            Rectangle {
                                border-radius: 10px;
                                border-width: 1.5px;
                                border-color: pick.selected ? pick.marker : Theme.text-muted.with-alpha(0.3);
                                background: pick.selected ? pick.marker.with-alpha(0.12) : pick.has-hover ? Theme.text.with-alpha(0.04) : transparent;
                                animate border-color, background { duration: 120ms; }
                            }

                            // A strip of washi tape holding the card, like on the cassettes.
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: -6px;
                                width: 46px;
                                height: 14px;
                                background: pick.marker.with-alpha(pick.selected ? 0.9 : 0.6);
                                transform-rotation: i == 1 ? 3deg : -3deg;
                                animate background { duration: 120ms; }
                            }

                            VerticalLayout {
                                padding: 12px;
                                padding-top: 20px;
                                spacing: 2px;
                                alignment: start;

                                Text {
                                    text: tape.name;
                                    font-family: Theme.font-hand;
                                    font-size: 28px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: tape.description;
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    max-height: 34px;
                                }
                            }
                        }
                    }
                }
            }

            source := Field {
                label: "source";
                placeholder: "user/repo, url or path";
                accepted => { root.submit(); }
            }

            name := Field {
                label: "name";
                placeholder: "optional";
                accepted => { root.submit(); }
            }

            HorizontalLayout {
                spacing: 14px;

                branch := Field {
                    label: "branch";
                    placeholder: "optional";
                    accepted => { root.submit(); }
                }

                dir := Field {
                    label: "dir";
                    placeholder: "optional";
                    accepted => { root.submit(); }
                }
            }

            if root.tried && !root.busy && root.status != "": Text {
                text: root.status;
                font-size: 14px;
                color: #e86f8a;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;

                Button {
                    width: 150px;
                    text: root.busy ? "installing…" : "install";
                    enabled: root.ready;
                    clicked => { root.submit(); }
                }
            }

            if root.busy: track := Rectangle {
                height: 8px;
                border-radius: 4px;
                background: Theme.text.with-alpha(0.12);
                clip: true;

                Rectangle {
                    x: 0;
                    width: track.width * Math.clamp(root.progress-value, 0, 1);
                    border-radius: 4px;
                    background: Theme.text;
                    animate width { duration: 160ms; easing: ease-out; }
                }
            }

            if root.busy: Text {
                text: root.progress != "" ? root.progress : "getting started…";
                font-size: 14px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }

    back-button := TouchArea {
        x: 32px;
        y: 28px;
        width: 90px;
        height: 36px;
        mouse-cursor: pointer;
        clicked => { root.back(); }

        Text {
            text: "← back";
            font-family: Theme.font-hand;
            font-size: 22px;
            color: back-button.has-hover ? Theme.text : Theme.text-muted;
        }
    }
}
