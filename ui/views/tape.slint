import { Theme } from "../theme.slint";
import { TapeInfo } from "../types.slint";

export component TapeView inherits Rectangle {
    in property <TapeInfo> tape;
    in property <color> marker;

    callback back();

    VerticalLayout {
        padding: 32px;
        spacing: 8px;
        alignment: start;

        back-button := TouchArea {
            width: 90px;
            height: 36px;
            mouse-cursor: pointer;
            clicked => { root.back(); }

            Text {
                x: 0;
                text: "← back";
                font-family: Theme.font-hand;
                font-size: 22px;
                color: back-button.has-hover ? Theme.text : Theme.text-muted;
            }
        }

        Text {
            text: root.tape.name;
            font-family: Theme.font-hand;
            font-size: 48px;
            font-weight: 700;
            color: Theme.text;
        }

        Rectangle {
            height: 4px;
            width: 160px;
            border-radius: 2px;
            background: root.marker;
        }

        Text {
            text: root.tape.source;
            font-family: Theme.font-hand;
            font-size: 20px;
            color: Theme.text-muted;
        }
    }
}
