import { Theme } from "../theme.slint";
import { Cassette } from "../components/cassette.slint";
import { Button } from "../components/button.slint";
import { DeckPanel } from "../components/deck-panel.slint";
import { OutputDialog } from "../components/output-dialog.slint";
import { SwapDialog } from "../components/swap-dialog.slint";
import { TapeGrid } from "../components/tape-grid.slint";
import { TapeInfo } from "../types.slint";
import { View } from "../components/view.slint";

export component LibraryView inherits View {
    in property <[TapeInfo]> tapes;
    in property <int> active: -1;
    in property <[string]> insert-hooks;
    in property <[string]> eject-hooks;
    in property <[string]> targets;
    in property <bool> busy;
    in property <string> status;
    in property <string> output;
    callback open-tape(int);
    callback add-tape();
    callback eject();
    callback insert(int);

    property <int> pressed: -1;
    property <int> confirm-target: -1;
    property <string> confirm-from;
    property <bool> confirm-open;
    property <int> ghost: -1;
    // A released tape that did not go into the deck flies back to its slot.
    property <bool> flying;
    property <length> home-x;
    property <length> home-y;
    // A dropped tape stays in the bay while the insert command runs.
    property <bool> holding;
    // Eject: the tape flies from the bay to its slot until the command, which waits for it to land, is done.
    property <bool> ejecting;
    // A swap ejects the current tape first, then inserts this one.
    property <int> pending: -1;
    property <bool> show-output;
    property <bool> dragging;
    property <length> press-x;
    property <length> press-y;
    property <length> mouse-x;
    property <length> mouse-y;
    property <length> grab-dx;
    property <length> grab-dy;

    property <bool> has-tape: root.active >= 0 && root.active < root.tapes.length;
    property <bool> wide: root.width >= 1300px && root.width >= root.height * 1.4;
    property <float> phase;
    property <length> header-height: 72px;

    property <length> deck-x: root.wide ? 32px : 24px;
    property <length> deck-y: root.header-height + 8px;
    property <length> deck-width: root.wide ? 408px : root.width - 48px;
    property <length> deck-height: root.wide ? root.height - root.header-height - 40px : 220px;
    property <float> bay-scale: root.wide ? (root.deck-width - 48px) / 520px : (root.deck-height - 40px) / 442px;
    property <length> bay-pad: root.wide ? 24px : 20px;
    property <length> bay-cx: root.deck-x + root.bay-pad + 260px * root.bay-scale;
    property <length> bay-cy: root.deck-y + root.bay-pad + 241px * root.bay-scale;
    property <bool> over-deck: root.dragging
        && root.mouse-x > root.deck-x && root.mouse-x < root.deck-x + root.deck-width
        && root.mouse-y > root.deck-y && root.mouse-y < root.deck-y + root.deck-height;

    function grab(i: int, x: length, y: length, cx: length, cy: length) {
        if root.busy { return; }
        root.pressed = i;
        root.flying = false;
        root.home-x = cx;
        root.home-y = cy;
        root.press-x = x;
        root.press-y = y;
        root.mouse-x = x;
        root.mouse-y = y;
        root.grab-dx = x - cx;
        root.grab-dy = y - cy;
    }

    function drag(x: length, y: length) {
        root.mouse-x = x;
        root.mouse-y = y;
        if root.pressed >= 0 && !root.dragging && abs(x - root.press-x) + abs(y - root.press-y) > 6px {
            root.dragging = true;
            root.ghost = root.pressed;
        }
    }

    function drop() {
        if root.dragging {
            if root.over-deck && root.pressed != root.active && !root.has-tape {
                root.holding = true;
                root.insert(root.pressed);
                if !root.busy {
                    root.holding = false;
                    root.flying = true;
                }
            } else {
                if root.over-deck && root.pressed != root.active {
                    root.confirm-target = root.pressed;
                    root.confirm-from = root.tapes[root.active].name;
                    root.confirm-open = true;
                    // The tape flies home and waits there until the swap goes ahead.
                    root.mouse-x = root.home-x;
                    root.mouse-y = root.home-y;
                    root.grab-dx = 0px;
                    root.grab-dy = 0px;
                }
                root.flying = true;
            }
        } else if root.pressed >= 0 {
            root.open-tape(root.pressed);
        }
        root.dragging = false;
        root.pressed = -1;
    }

    function insert-pending() {
        root.ghost = root.pending;
        root.pending = -1;
        root.holding = true;
        root.insert(root.ghost);
        if !root.busy {
            root.holding = false;
            root.flying = true;
        }
    }

    function start-eject() {
        root.ghost = root.active;
        root.ejecting = true;
        root.eject();
        if !root.busy {
            root.ejecting = false;
        }
    }

    changed busy => {
        if !root.busy && root.ejecting {
            root.ejecting = false;
            if root.pending >= 0 && !root.has-tape {
                root.insert-pending();
            } else {
                root.pending = -1;
            }
        }
        if !root.busy && root.holding {
            root.holding = false;
            if !root.has-tape {
                root.flying = true;
            }
        }
    }

    Timer {
        interval: 420ms;
        running: root.flying;
        triggered => { root.flying = false; }
    }

    Timer {
        interval: 16ms;
        running: root.has-tape && root.shown;
        triggered => { root.phase += 1.1; }
    }

    if root.wide: HorizontalLayout {
        x: 0;
        y: root.header-height;
        width: root.width;
        height: root.height - root.header-height;
        padding: 32px;
        padding-top: 8px;
        spacing: 40px;

        DeckPanel {
            width: 408px;
            compact: false;
            tapes: root.tapes;
            active: root.active;
            phase: root.phase;
            insert-hooks: root.insert-hooks;
            eject-hooks: root.eject-hooks;
            targets: root.targets;
            busy: root.busy;
            status: root.status;
            drop-hint: root.over-deck;
            ejecting: root.ejecting;
            live: root.shown;
            eject => { root.start-eject(); }
        }

        TapeGrid {
            tapes: root.tapes;
            active: root.active;
            lifted: root.dragging || root.flying || root.holding || root.ejecting ? root.ghost : -1;
            fly-index: root.ghost;
            ejecting: root.ejecting;
            bay-x: root.bay-cx;
            bay-y: root.bay-cy;
            bay-scale: root.bay-scale;
            grab(i, x, y, cx, cy) => { root.grab(i, x, y, cx, cy); }
            drag(x, y) => { root.drag(x, y); }
            drop => { root.drop(); }
        }
    }

    if !root.wide: VerticalLayout {
        x: 0;
        y: root.header-height;
        width: root.width;
        height: root.height - root.header-height;
        padding: 24px;
        padding-top: 8px;
        spacing: 20px;

        DeckPanel {
            height: 220px;
            compact: true;
            tapes: root.tapes;
            active: root.active;
            phase: root.phase;
            insert-hooks: root.insert-hooks;
            eject-hooks: root.eject-hooks;
            targets: root.targets;
            busy: root.busy;
            status: root.status;
            drop-hint: root.over-deck;
            ejecting: root.ejecting;
            live: root.shown;
            eject => { root.start-eject(); }
        }

        TapeGrid {
            tapes: root.tapes;
            active: root.active;
            lifted: root.dragging || root.flying || root.holding || root.ejecting ? root.ghost : -1;
            fly-index: root.ghost;
            ejecting: root.ejecting;
            bay-x: root.bay-cx;
            bay-y: root.bay-cy;
            bay-scale: root.bay-scale;
            grab(i, x, y, cx, cy) => { root.grab(i, x, y, cx, cy); }
            drag(x, y) => { root.drag(x, y); }
            drop => { root.drop(); }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.header-height;

        Text {
            x: 32px;
            y: (parent.height - self.height) / 2;
            text: "tapes";
            font-family: Theme.font-hand;
            font-size: 36px;
            font-weight: 700;
            color: Theme.text;
        }

        Button {
            x: parent.width - self.width - 32px;
            y: (parent.height - self.height) / 2;
            width: 170px;
            text: "+ add tape";
            clicked => { root.add-tape(); }
        }

        if root.output != "": Button {
            x: parent.width - 170px - 32px - self.width - 16px;
            y: (parent.height - self.height) / 2;
            width: 120px;
            text: "output";
            clicked => { root.show-output = true; }
        }
    }

    // Follows the cursor while dragging. On release it flies into the bay (and waits there until the
    // deck takes over) or back to its slot in the grid.
    Rectangle {
        property <float> size: root.dragging ? (root.over-deck ? 0.7 : 0.6) : root.holding ? root.bay-scale : 0.6;

        x: root.holding ? root.bay-cx - 200px : root.flying ? root.home-x - 200px : root.mouse-x - root.grab-dx - 200px;
        y: root.holding ? root.bay-cy - 128px : root.flying ? root.home-y - 128px : root.mouse-y - root.grab-dy - 128px;
        width: 400px;
        height: 256px;
        visible: root.dragging || root.holding || root.flying;
        transform-scale: self.size;
        transform-rotation: root.dragging && !root.over-deck ? -5deg : 0deg;
        animate x, y {
            duration: root.dragging ? 0ms : root.holding ? 260ms : 420ms;
            easing: cubic-bezier(0.25, 0.9, 0.3, 1.1);
        }
        animate size { duration: root.dragging ? 150ms : root.holding ? 260ms : 420ms; easing: ease-out; }
        animate transform-rotation { duration: 150ms; easing: ease-out; }

        if root.ghost >= 0 && root.ghost < root.tapes.length: Cassette {
            name: root.tapes[root.ghost].name;
            subtitle: root.tapes[root.ghost].source;
            side: Math.mod(root.ghost, 2) == 0 ? "A" : "B";
            marker: Theme.marker(root.ghost);
        }
    }

    SwapDialog {
        open: root.confirm-open;
        accent: Theme.marker(root.confirm-target);
        from-name: root.confirm-from;
        to-name: root.tapes[root.confirm-target].name;
        eject-hooks: root.eject-hooks.length;
        dismissed => { root.confirm-open = false; }
        confirmed => {
            root.pending = root.confirm-target;
            root.confirm-open = false;
            root.start-eject();
        }
    }

    OutputDialog {
        open: root.show-output;
        text: root.output;
        dismissed => { root.show-output = false; }
    }
}
