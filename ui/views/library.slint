import { Theme } from "../theme.slint";
import { Cassette } from "../components/cassette.slint";
import { Player } from "../components/player.slint";
import { Button } from "../components/button.slint";
import { Panel } from "../components/panel.slint";
import { Sketch } from "../components/sketch-paths.slint";
import { TapeInfo } from "../types.slint";

component Signal inherits Rectangle {
    in property <float> phase;
    in property <color> line-color;

    height: 80px;
    clip: true;

    Path {
        x: -84px - Math.mod(root.phase * 2, 84) * 1px;
        y: -4px;
        width: 3108px;
        height: 80px;
        viewbox-width: 3108;
        viewbox-height: 80;
        stroke: root.line-color;
        stroke-width: 2.5px;
        commands: Sketch.signal-big;
    }

    Path {
        x: -84px - Math.mod(root.phase * 1.2 + 42, 84) * 1px;
        y: 6px;
        width: 3108px;
        height: 80px;
        viewbox-width: 3108;
        viewbox-height: 80;
        stroke: Theme.text.with-alpha(0.3);
        stroke-width: 2px;
        commands: Sketch.signal-small;
    }
}

component HookList inherits VerticalLayout {
    in property <string> title;
    in property <[string]> hooks;

    spacing: 2px;

    Text {
        text: root.title;
        font-family: Theme.font-hand;
        font-size: 18px;
        color: Theme.text-muted;
    }

    if root.hooks.length == 0: Text {
        text: "(none)";
        font-family: "JetBrains Mono";
        font-size: 12px;
        color: Theme.text-muted.with-alpha(0.6);
    }

    for hook in root.hooks: Text {
        text: "› " + hook;
        font-family: "JetBrains Mono";
        font-size: 12px;
        color: Theme.text.with-alpha(0.85);
        overflow: elide;
    }
}

component PlayerBox inherits Rectangle {
    in property <float> scale;
    in property <bool> loaded;
    in property <string> name;
    in property <string> subtitle;
    in property <string> side;
    in property <color> marker;
    in property <bool> busy;
    in property <bool> show-eject: true;

    callback eject();

    width: 520px * root.scale;
    height: 442px * root.scale;

    Rectangle {
        x: 260px * (root.scale - 1);
        y: 221px * (root.scale - 1);
        width: 520px;
        height: 442px;
        transform-scale: root.scale;

        Player {
            loaded: root.loaded;
            name: root.name;
            subtitle: root.subtitle;
            side: root.side;
            marker: root.marker;
            playing: true;
            busy: root.busy;
            show-eject: root.show-eject;
            eject => { root.eject(); }
        }
    }
}

component SignalBox inherits Rectangle {
    in property <bool> playing;
    in property <float> phase;
    in property <color> line-color;

    height: 48px;

    if root.playing: Signal {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        phase: root.phase;
        line-color: root.line-color;
    }

    if !root.playing: Rectangle {
        y: parent.height / 2;
        height: 1.5px;
        background: Theme.text-muted.with-alpha(0.4);
    }
}

component DeckPanel inherits Panel {
    in property <[TapeInfo]> tapes;
    in property <int> active: -1;
    in property <float> phase;
    in property <[string]> insert-hooks;
    in property <[string]> eject-hooks;
    in property <[string]> targets;
    in property <bool> compact;
    in property <bool> busy;
    in property <string> status;
    in property <bool> drop-hint;

    callback eject();

    border-color: root.drop-hint ? Theme.text : Theme.text-muted.with-alpha(0.2);
    border-width: root.drop-hint ? 2px : 1px;

    property <bool> has-tape: root.active >= 0 && root.active < root.tapes.length;
    property <string> name: root.has-tape ? root.tapes[root.active].name : "nothing inserted";
    property <string> source: root.has-tape ? root.tapes[root.active].source : "pick a tape on the right";

    if !root.compact: VerticalLayout {
        padding: 24px;
        spacing: 12px;

        PlayerBox {
            scale: (parent.width - 48px) / 520px;
            loaded: root.has-tape;
            name: root.has-tape ? root.name : "";
            subtitle: root.has-tape ? root.source : "";
            side: Math.mod(root.active, 2) == 0 ? "A" : "B";
            marker: Theme.marker(root.active);
            busy: root.busy;
            eject => { root.eject(); }
        }

        SignalBox {
            playing: root.has-tape;
            phase: root.phase;
            line-color: Theme.marker(root.active);
        }

        Text {
            text: root.name;
            font-family: Theme.font-hand;
            font-size: 30px;
            font-weight: 700;
            color: root.has-tape ? Theme.text : Theme.text-muted;
            overflow: elide;
        }

        Text {
            text: root.source;
            font-family: Theme.font-hand;
            font-size: 17px;
            color: Theme.text-muted;
            overflow: elide;
        }

        if root.status != "": Text {
            text: root.status;
            font-family: Theme.font-hand;
            font-size: 17px;
            color: #e86f8a;
            wrap: word-wrap;
        }

        if root.has-tape: VerticalLayout {
            spacing: 14px;
            padding-top: 8px;

            HookList {
                title: "on insert";
                hooks: root.insert-hooks;
            }

            HookList {
                title: "on eject";
                hooks: root.eject-hooks;
            }

            Text {
                text: "touches " + root.targets.length + " configs";
                font-family: Theme.font-hand;
                font-size: 18px;
                color: Theme.text-muted;
            }
        }

        targets := Flickable {
            vertical-stretch: 1;
            visible: root.has-tape;
            content-height: Math.ceil(root.targets.length / 2) * 20px;

            for target[k] in root.targets: Text {
                x: Math.mod(k, 2) * targets.width / 2;
                y: Math.floor(k / 2) * 20px;
                width: targets.width / 2 - 8px;
                text: target;
                font-family: "JetBrains Mono";
                font-size: 12px;
                color: Theme.text.with-alpha(0.7);
                overflow: elide;
            }
        }
    }

    if root.compact: HorizontalLayout {
        padding: 20px;
        spacing: 24px;

        PlayerBox {
            scale: (parent.height - 40px) / 442px;
            show-eject: false;
            loaded: root.has-tape;
            name: root.has-tape ? root.name : "";
            subtitle: root.has-tape ? root.source : "";
            side: Math.mod(root.active, 2) == 0 ? "A" : "B";
            marker: Theme.marker(root.active);
            busy: root.busy;
            eject => { root.eject(); }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: root.name;
                font-family: Theme.font-hand;
                font-size: 30px;
                font-weight: 700;
                color: root.has-tape ? Theme.text : Theme.text-muted;
                overflow: elide;
            }

            Text {
                text: root.source;
                font-family: Theme.font-hand;
                font-size: 17px;
                color: Theme.text-muted;
                overflow: elide;
            }

            if root.status != "": Text {
                text: root.status;
                font-family: Theme.font-hand;
                font-size: 17px;
                color: #e86f8a;
                wrap: word-wrap;
            }

            SignalBox {
                playing: root.has-tape;
                phase: root.phase;
                line-color: Theme.marker(root.active);
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: start;

                if root.has-tape: Button {
                    width: 120px;
                    height: 36px;
                    font-size: 19px;
                    text: root.busy ? "busy…" : "⏏  eject";
                    enabled: !root.busy;
                    clicked => { root.eject(); }
                }

                if root.has-tape: Text {
                    text: root.insert-hooks.length + " hooks on insert · touches " + root.targets.length + " configs";
                    font-family: Theme.font-hand;
                    font-size: 17px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component TapeGrid inherits VerticalLayout {
    in property <[TapeInfo]> tapes;
    in property <int> active: -1;
    in property <int> lifted: -1;

    callback grab(int, length, length, length, length);
    callback drag(length, length);
    callback drop();

    property <float> card-size: 0.6;
    property <length> card-width: 400px * root.card-size;
    property <length> card-height: 256px * root.card-size;
    property <length> gap: 28px;

    spacing: 16px;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        Text {
            text: "my tapes";
            font-family: Theme.font-hand;
            font-size: 32px;
            font-weight: 700;
            color: Theme.text;
        }

        Text {
            text: "(" + root.tapes.length + ")";
            font-family: Theme.font-hand;
            font-size: 22px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }

    grid := Flickable {
        mouse-drag-pan-enabled: false;

        property <int> columns: Math.max(1, Math.floor((self.width + root.gap) / (root.card-width + root.gap)));

        content-height: Math.ceil(root.tapes.length / self.columns) * (root.card-height + root.gap) + 12px;

        for tape[i] in root.tapes: Rectangle {
            x: Math.mod(i, grid.columns) * (root.card-width + root.gap);
            y: 12px + Math.floor(i / grid.columns) * (root.card-height + root.gap) - (touch.has-hover ? 6px : 0);
            width: root.card-width;
            height: root.card-height;
            opacity: i == root.lifted ? 0 : i == root.active ? 0.35 : 1;
            animate y { duration: 150ms; easing: ease-out; }

            Cassette {
                transform-scale: root.card-size;
                name: tape.name;
                subtitle: tape.source;
                side: Math.mod(i, 2) == 0 ? "A" : "B";
                marker: Theme.marker(i);
            }

            touch := TouchArea {
                mouse-cursor: root.lifted >= 0 ? MouseCursor.grabbing : MouseCursor.grab;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.grab(i,
                            self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y,
                            self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height / 2);
                    } else if event.kind == PointerEventKind.up {
                        root.drop();
                    }
                }
                moved => {
                    root.drag(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

export component LibraryView inherits Rectangle {
    in property <[TapeInfo]> tapes;
    in property <int> active: -1;
    in property <[string]> insert-hooks;
    in property <[string]> eject-hooks;
    in property <[string]> targets;
    in property <bool> busy;
    in property <string> status;
    in property <string> output;

    callback open-tape(int);
    callback add-tape();
    callback eject();
    callback insert(int);

    property <int> pressed: -1;
    property <int> confirm-target: -1;
    property <bool> show-output;
    property <bool> dragging;
    property <length> press-x;
    property <length> press-y;
    property <length> mouse-x;
    property <length> mouse-y;
    property <length> grab-dx;
    property <length> grab-dy;

    property <bool> has-tape: root.active >= 0 && root.active < root.tapes.length;
    property <bool> wide: root.width >= 1300px && root.width >= root.height * 1.4;
    property <float> phase;
    property <length> header-height: 72px;

    property <length> deck-x: root.wide ? 32px : 24px;
    property <length> deck-y: root.header-height + 8px;
    property <length> deck-width: root.wide ? 408px : root.width - 48px;
    property <length> deck-height: root.wide ? root.height - root.header-height - 40px : 220px;
    property <bool> over-deck: root.dragging
        && root.mouse-x > root.deck-x && root.mouse-x < root.deck-x + root.deck-width
        && root.mouse-y > root.deck-y && root.mouse-y < root.deck-y + root.deck-height;

    function grab(i: int, x: length, y: length, cx: length, cy: length) {
        if root.busy { return; }
        root.pressed = i;
        root.press-x = x;
        root.press-y = y;
        root.mouse-x = x;
        root.mouse-y = y;
        root.grab-dx = x - cx;
        root.grab-dy = y - cy;
    }

    function drag(x: length, y: length) {
        root.mouse-x = x;
        root.mouse-y = y;
        if root.pressed >= 0 && !root.dragging && abs(x - root.press-x) + abs(y - root.press-y) > 6px {
            root.dragging = true;
        }
    }

    function drop() {
        if root.dragging {
            if root.over-deck && root.pressed != root.active {
                if root.has-tape {
                    root.confirm-target = root.pressed;
                } else {
                    root.insert(root.pressed);
                }
            }
        } else if root.pressed >= 0 {
            root.open-tape(root.pressed);
        }
        root.dragging = false;
        root.pressed = -1;
    }

    Timer {
        interval: 16ms;
        running: root.has-tape;
        triggered => { root.phase += 1.1; }
    }

    if root.wide: HorizontalLayout {
        x: 0;
        y: root.header-height;
        width: root.width;
        height: root.height - root.header-height;
        padding: 32px;
        padding-top: 8px;
        spacing: 40px;

        DeckPanel {
            width: 408px;
            compact: false;
            tapes: root.tapes;
            active: root.active;
            phase: root.phase;
            insert-hooks: root.insert-hooks;
            eject-hooks: root.eject-hooks;
            targets: root.targets;
            busy: root.busy;
            status: root.status;
            drop-hint: root.over-deck;
            eject => { root.eject(); }
        }

        TapeGrid {
            tapes: root.tapes;
            active: root.active;
            lifted: root.dragging ? root.pressed : -1;
            grab(i, x, y, cx, cy) => { root.grab(i, x, y, cx, cy); }
            drag(x, y) => { root.drag(x, y); }
            drop => { root.drop(); }
        }
    }

    if !root.wide: VerticalLayout {
        x: 0;
        y: root.header-height;
        width: root.width;
        height: root.height - root.header-height;
        padding: 24px;
        padding-top: 8px;
        spacing: 20px;

        DeckPanel {
            height: 220px;
            compact: true;
            tapes: root.tapes;
            active: root.active;
            phase: root.phase;
            insert-hooks: root.insert-hooks;
            eject-hooks: root.eject-hooks;
            targets: root.targets;
            busy: root.busy;
            status: root.status;
            drop-hint: root.over-deck;
            eject => { root.eject(); }
        }

        TapeGrid {
            tapes: root.tapes;
            active: root.active;
            lifted: root.dragging ? root.pressed : -1;
            grab(i, x, y, cx, cy) => { root.grab(i, x, y, cx, cy); }
            drag(x, y) => { root.drag(x, y); }
            drop => { root.drop(); }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.header-height;

        Text {
            x: 32px;
            y: (parent.height - self.height) / 2;
            text: "tapes";
            font-family: Theme.font-hand;
            font-size: 36px;
            font-weight: 700;
            color: Theme.text;
        }

        Button {
            x: parent.width - self.width - 32px;
            y: (parent.height - self.height) / 2;
            width: 170px;
            text: "+ add tape";
            clicked => { root.add-tape(); }
        }

        if root.output != "": Button {
            x: parent.width - 170px - 32px - self.width - 16px;
            y: (parent.height - self.height) / 2;
            width: 120px;
            text: "output";
            clicked => { root.show-output = true; }
        }
    }

    if root.dragging && root.pressed >= 0 && root.pressed < root.tapes.length: Rectangle {
        property <float> size: root.over-deck ? 0.7 : 0.6;

        x: root.mouse-x - root.grab-dx * self.size / 0.6 - 200px;
        y: root.mouse-y - root.grab-dy * self.size / 0.6 - 128px;
        width: 400px;
        height: 256px;
        transform-scale: self.size;
        transform-rotation: root.over-deck ? 0deg : -5deg;
        animate transform-scale, transform-rotation { duration: 150ms; easing: ease-out; }

        Cassette {
            name: root.tapes[root.pressed].name;
            subtitle: root.tapes[root.pressed].source;
            side: Math.mod(root.pressed, 2) == 0 ? "A" : "B";
            marker: Theme.marker(root.pressed);
        }
    }

    if root.confirm-target >= 0 && root.confirm-target < root.tapes.length && root.has-tape: Rectangle {
        width: root.width;
        height: root.height;
        background: #000000a0;

        TouchArea {
            clicked => { root.confirm-target = -1; }
        }

        Rectangle {
            width: Math.min(440px, root.width - 48px);
            height: 250px;
            background: Theme.sheet;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: Theme.marker(root.confirm-target);

            TouchArea { }

            VerticalLayout {
                padding: 28px;
                spacing: 12px;

                Text {
                    text: "swap tapes?";
                    font-family: Theme.font-hand;
                    font-size: 34px;
                    font-weight: 700;
                    color: Theme.text;
                }

                Text {
                    text: root.tapes[root.active].name + " gets ejected first";
                    font-family: Theme.font-hand;
                    font-size: 22px;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                Text {
                    text: "then " + root.tapes[root.confirm-target].name + " goes in"
                        + (root.eject-hooks.length > 0 ? " · " + root.eject-hooks.length + " eject hooks run" : "");
                    font-family: Theme.font-hand;
                    font-size: 19px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 16px;

                    Button {
                        width: 110px;
                        text: "cancel";
                        clicked => { root.confirm-target = -1; }
                    }

                    Button {
                        width: 130px;
                        text: "swap";
                        clicked => {
                            root.insert(root.confirm-target);
                            root.confirm-target = -1;
                        }
                    }
                }
            }
        }
    }

    if root.show-output: Rectangle {
        width: root.width;
        height: root.height;
        background: #000000a0;

        TouchArea {
            clicked => { root.show-output = false; }
        }

        Rectangle {
            width: Math.min(720px, root.width - 48px);
            height: Math.min(520px, root.height - 48px);
            background: Theme.sheet;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: Theme.text-muted.with-alpha(0.4);

            TouchArea { }

            VerticalLayout {
                padding: 28px;
                spacing: 12px;

                Text {
                    text: "last output";
                    font-family: Theme.font-hand;
                    font-size: 34px;
                    font-weight: 700;
                    color: Theme.text;
                }

                output-view := Flickable {
                    vertical-stretch: 1;
                    content-height: output-text.preferred-height;

                    output-text := Text {
                        width: output-view.width;
                        text: root.output;
                        font-family: "JetBrains Mono";
                        font-size: 12px;
                        color: Theme.text.with-alpha(0.85);
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    alignment: end;

                    Button {
                        width: 110px;
                        text: "close";
                        clicked => { root.show-output = false; }
                    }
                }
            }
        }
    }
}
