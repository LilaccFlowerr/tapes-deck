import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";
import { Panel } from "../components/panel.slint";
import { View } from "../components/view.slint";

component Nudge inherits TouchArea {
    in property <string> glyph;
    in property <bool> active: true;

    width: 24px;
    enabled: root.active;
    mouse-cursor: root.active ? MouseCursor.pointer : MouseCursor.default;
    opacity: root.active ? (root.has-hover ? 1 : 0.55) : 0.15;

    Text {
        text: root.glyph;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.text;
    }
}

component Track inherits Rectangle {
    in property <int> number;
    in property <string> text;
    in property <string> note;
    in property <color> marker;
    in property <bool> first;
    in property <bool> last;

    callback edited(string);
    callback up();
    callback down();
    callback remove();

    height: 52px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.text-muted.with-alpha(0.25);
    }

    Text {
        width: 30px;
        height: parent.height;
        text: root.number + ".";
        font-family: Theme.font-hand;
        font-size: 26px;
        font-weight: 700;
        color: root.marker;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Text {
        x: 40px;
        y: 7px;
        width: parent.width - 120px;
        text: root.note;
        font-size: 13px;
        color: Theme.text;
        overflow: elide;
    }

    Rectangle {
        x: 40px;
        y: 26px;
        width: parent.width - 120px;
        height: 22px;
        clip: true;

        input := TextInput {
            width: parent.width;
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            text: root.text;
            font-family: "JetBrains Mono";
            font-size: 12px;
            color: Theme.text-muted;
            edited => { root.edited(self.text); }
            init => {
                if self.text == "" {
                    self.focus();
                }
            }
        }

        if input.text == "": Text {
            text: "type a command";
            font-family: Theme.font-hand;
            font-size: 20px;
            color: Theme.text-muted.with-alpha(0.5);
            vertical-alignment: center;
        }
    }

    Nudge { x: parent.width - 72px; height: parent.height; glyph: "↑"; active: !root.first; clicked => { root.up(); } }
    Nudge { x: parent.width - 48px; height: parent.height; glyph: "↓"; active: !root.last; clicked => { root.down(); } }
    Nudge { x: parent.width - 24px; height: parent.height; glyph: "×"; clicked => { root.remove(); } }
}

component TrackList inherits VerticalLayout {
    in property <[string]> hooks;
    in property <color> marker;
    in property <string> empty-text: "no tracks yet";

    pure callback describe(string) -> string;
    callback changed(int, string);
    callback added();
    callback removed(int);
    callback moved(int, int);

    property <length> track-height: 52px;

    if root.hooks.length == 0: Text {
        height: 36px;
        text: root.empty-text;
        font-family: Theme.font-hand;
        font-size: 22px;
        color: Theme.text-muted.with-alpha(0.6);
        vertical-alignment: center;
    }

    Rectangle {
        vertical-stretch: 1;

        list := Flickable {
            width: parent.width;
            height: parent.height;
            mouse-drag-pan-enabled: false;
            content-height: root.hooks.length * root.track-height;

            for hook[i] in root.hooks: Track {
                y: i * root.track-height;
                width: parent.width;
                number: i + 1;
                text: hook;
                note: root.describe(hook);
                marker: root.marker;
                first: i == 0;
                last: i == root.hooks.length - 1;
                edited(text) => { root.changed(i, text); }
                up => { root.moved(i, -1); }
                down => { root.moved(i, 1); }
                remove => { root.removed(i); }
            }
        }

        if root.hooks.length * root.track-height > list.height: Rectangle {
            x: parent.width - 3px;
            y: -list.content-y * list.height / (root.hooks.length * root.track-height);
            width: 3px;
            height: list.height * list.height / (root.hooks.length * root.track-height);
            border-radius: 2px;
            background: Theme.text-muted.with-alpha(0.5);
        }
    }

    add := TouchArea {
        height: 40px;
        mouse-cursor: pointer;
        clicked => {
            root.added();
            list.content-y = Math.min(0px, list.height - root.hooks.length * root.track-height);
        }

        Text {
            x: 40px;
            text: "+ add track";
            font-family: Theme.font-hand;
            font-size: 24px;
            color: add.has-hover ? root.marker : Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

component Summary inherits Rectangle {
    in property <string> title;
    in property <[string]> hooks;
    in property <color> marker;

    pure callback describe(string) -> string;

    Text {
        width: parent.width;
        height: 28px;
        text: root.title + " · " + root.hooks.length;
        font-family: Theme.font-hand;
        font-size: 24px;
        font-weight: 700;
        color: root.marker;
        vertical-alignment: center;
    }

    if root.hooks.length == 0: Text {
        y: 30px;
        height: 22px;
        text: "nothing";
        font-size: 13px;
        color: Theme.text-muted.with-alpha(0.7);
        vertical-alignment: center;
    }

    for hook[i] in root.hooks: Text {
        y: 30px + i * 22px;
        width: parent.width;
        height: 22px;
        text: (i + 1) + ". " + (root.describe(hook) != "" ? root.describe(hook) : hook);
        font-size: 13px;
        color: Theme.text;
        overflow: elide;
        vertical-alignment: center;
    }
}

component Hint inherits HorizontalLayout {
    in property <string> text;
    in property <color> marker;

    spacing: 12px;

    Rectangle {
        width: 3px;
        border-radius: 2px;
        background: root.marker;
    }

    Text {
        horizontal-stretch: 1;
        text: root.text;
        wrap: word-wrap;
        font-size: 14px;
        color: Theme.text-muted;
    }
}

component Tab inherits TouchArea {
    in property <string> label;
    in property <bool> selected;
    in property <color> marker;

    mouse-cursor: pointer;
    width: text.preferred-width + 8px;

    text := Text {
        text: root.label;
        font-family: Theme.font-hand;
        font-size: 26px;
        font-weight: root.selected ? 700 : 400;
        color: root.selected || root.has-hover ? Theme.text : Theme.text-muted;
    }

    Rectangle {
        y: parent.height - 4px;
        height: 3px;
        border-radius: 2px;
        width: root.selected ? parent.width : 0;
        background: root.marker;
    }
}

export component EditorView inherits View {
    in property <string> tape;
    in-out property <string> name;
    in-out property <string> desc;
    in property <[string]> insert-hooks;
    in property <[string]> eject-hooks;
    in property <[string]> install-hooks;
    in property <string> error;
    in property <[string]> guide;

    pure callback describe(string) -> string;
    callback hook-changed(int, int, string);
    callback hook-added(int);
    callback hook-removed(int, int);
    callback hook-moved(int, int, int);
    callback save();
    callback skip();

    property <int> step: 0;
    property <color> marker: Theme.marker(root.step);

    pure function lead(i: int) -> string {
        return root.guide[i] != "" ? root.guide[i] + " " : "";
    }

    changed shown => {
        if root.shown {
            root.step = 0;
        }
    }

    Panel {
        width: Math.min(600px, root.width - 48px);
        height: Math.min(620px, root.height - 32px);

        Text {
            x: 32px;
            y: 26px;
            width: parent.width - 64px;
            text: "set up " + root.tape;
            font-family: Theme.font-hand;
            font-size: 40px;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }

        Text {
            x: 32px;
            y: 76px;
            text: "step " + (root.step + 1) + " of 4";
            font-size: 13px;
            color: Theme.text-muted;
        }

        HorizontalLayout {
            x: 32px;
            y: 100px;
            width: parent.width - 64px;
            height: 36px;
            spacing: 22px;
            alignment: start;

            for step-name[i] in ["about", "insert", "eject", "finish"]: Tab {
                label: step-name;
                selected: root.step == i;
                marker: Theme.marker(i);
                clicked => { root.step = i; }
            }
        }

        body := Rectangle {
            x: 32px;
            y: 152px;
            width: parent.width - 64px;
            height: parent.height - 152px - 32px - 42px - 14px;
            clip: true;

            if root.step == 0: VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 20px;
                alignment: start;

                Hint {
                    marker: root.marker;
                    text: root.lead(0) + "A tape.toml is the ID card of a tape: its name, a short description and its hooks. Hooks are small commands that run when something happens to the tape. We'll go through them one by one.";
                }

                Rectangle {
                    height: label.preferred-height;
                    border-radius: 10px;
                    border-width: 1.5px;
                    border-color: Theme.text-muted.with-alpha(0.3);
                    background: Theme.background.with-alpha(0.5);

                    Rectangle {
                        x: 28px;
                        y: -8px;
                        width: 60px;
                        height: 16px;
                        background: root.marker.with-alpha(0.8);
                        transform-rotation: -3deg;
                    }

                    label := VerticalLayout {
                        padding: 18px;
                        padding-top: 24px;
                        spacing: 2px;

                        TextInput {
                            single-line: true;
                            wrap: no-wrap;
                            text <=> root.name;
                            font-family: Theme.font-hand;
                            font-size: 46px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        TextInput {
                            wrap: word-wrap;
                            text <=> root.desc;
                            font-size: 14px;
                            color: Theme.text-muted;
                        }
                    }
                }
            }

            if root.step == 1 || root.step == 2: Rectangle {
                width: parent.width;
                height: parent.height;

                Hint {
                    width: parent.width;
                    height: 84px;
                    marker: root.marker;
                    text: root.step == 1
                        ? root.lead(1) + "These run, in this order, right after you insert the tape. If one fails, the ones after it are skipped."
                        : root.lead(2) + "These run right after you eject the tape. Your old config is back by then, but whatever the tape started has been stopped. Type the commands that bring your own setup back, in the order they should run.";
                }

                if root.step == 2: Text {
                    y: 92px;
                    height: 34px;
                    text: "revive your own config here";
                    font-family: Theme.font-hand;
                    font-size: 26px;
                    font-weight: 700;
                    color: root.marker;
                    vertical-alignment: center;
                }

                TrackList {
                    y: root.step == 1 ? 96px : 130px;
                    width: parent.width;
                    height: parent.height - self.y;
                    hooks: root.step == 1 ? root.insert-hooks : root.eject-hooks;
                    marker: root.marker;
                    empty-text: root.step == 1 ? "no tracks yet" : "nothing yet: add what starts your own setup again";
                    describe(command) => { root.describe(command) }
                    changed(i, text) => { root.hook-changed(root.step - 1, i, text); }
                    added => { root.hook-added(root.step - 1); }
                    removed(i) => { root.hook-removed(root.step - 1, i); }
                    moved(i, by) => { root.hook-moved(root.step - 1, i, by); }
                }
            }

            if root.step == 3: finish := Rectangle {
                width: parent.width;
                height: parent.height;
                property <bool> has-install: root.install-hooks.length > 0;
                property <length> column: (self.width - (self.has-install ? 2 : 1) * 20px) / (self.has-install ? 3 : 2);

                Hint {
                    width: parent.width;
                    height: 84px;
                    marker: root.marker;
                    text: root.lead(3) + "This is what you set up. Save writes it to the tape.toml of this tape.";
                }

                Text {
                    y: 92px;
                    width: parent.width;
                    height: 34px;
                    text: root.name != "" ? root.name : "(no name)";
                    font-family: Theme.font-hand;
                    font-size: 30px;
                    font-weight: 700;
                    color: Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                }

                Text {
                    y: 128px;
                    width: parent.width;
                    height: 20px;
                    text: root.desc;
                    font-size: 13px;
                    color: Theme.text-muted;
                    overflow: elide;
                }

                Summary {
                    y: 164px;
                    width: finish.column;
                    height: parent.height - 164px;
                    title: "insert";
                    hooks: root.insert-hooks;
                    marker: Theme.marker(1);
                    describe(command) => { root.describe(command) }
                }

                Summary {
                    x: finish.column + 20px;
                    y: 164px;
                    width: finish.column;
                    height: parent.height - 164px;
                    title: "eject";
                    hooks: root.eject-hooks;
                    marker: Theme.marker(2);
                    describe(command) => { root.describe(command) }
                }

                if finish.has-install: Summary {
                    x: 2 * (finish.column + 20px);
                    y: 164px;
                    width: finish.column;
                    height: parent.height - 164px;
                    title: "at install";
                    hooks: root.install-hooks;
                    marker: Theme.marker(3);
                    describe(command) => { root.describe(command) }
                }
            }
        }

        HorizontalLayout {
            x: 32px;
            y: parent.height - 32px - 42px;
            width: parent.width - 64px;
            height: 42px;
            spacing: 12px;

            Button { width: 110px; text: "skip"; clicked => { root.skip(); } }
            Text {
                horizontal-stretch: 1;
                text: root.error;
                font-size: 13px;
                color: #e86f8a;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.step > 0: Button { width: 110px; text: "back"; clicked => { root.step -= 1; } }
            if root.step < 3: Button { width: 130px; text: "next"; clicked => { root.step += 1; } }
            if root.step == 3: Button { width: 130px; text: "save"; clicked => { root.save(); } }
        }
    }
}
