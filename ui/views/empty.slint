import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";
import { View } from "../components/view.slint";
import { Button } from "../components/button.slint";

export component EmptyView inherits View {
    in property <bool> missing;
    in property <bool> busy;
    in property <string> status;

    callback open-tapes-page();
    callback add-tape();
    callback install-cli();

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        TouchArea {
            height: 260px;
            mouse-cursor: root.missing ? MouseCursor.default : MouseCursor.pointer;
            clicked => {
                if !root.missing {
                    root.add-tape();
                }
            }

            Image {
                width: 320px;
                height: 243px;
                source: @image-url("../../assets/add-tape.svg");
            }
        }
        HorizontalLayout {
            alignment: center;

            Button {
                width: 170px;
                text: "+ add tape";
                clicked => { root.add-tape(); }
            }
        }
        if !root.missing: Text {
            text: "no tapes yet";
            horizontal-alignment: center;
            font-size: 14px;
            color: Theme.text-muted;
        }
        if root.missing: Text {
            text: root.busy ? "downloading from github, one moment" : "tapes-deck needs it to work. install it now?";
            horizontal-alignment: center;
            font-size: 14px;
            color: Theme.text-muted;
        }
        if root.missing && !root.busy: HorizontalLayout {
            alignment: center;

            Button {
                width: 220px;
                text: root.status != "" ? "try again" : "yes, install it";
                clicked => { root.install-cli(); }
            }
        }
        if root.missing && root.status != "": Text {
            text: root.status;
            horizontal-alignment: center;
            wrap: word-wrap;
            font-size: 14px;
            color: Theme.text-muted;
        }
        if root.missing: link := TouchArea {
            height: 24px;
            mouse-cursor: pointer;
            clicked => { root.open-tapes-page(); }

            label := Text {
                width: parent.width;
                text: "github.com/futurekismo-oss/tapes-v2";
                horizontal-alignment: center;
                font-size: 14px;
                color: link.has-hover ? Theme.text : Theme.text-muted;
            }

            Rectangle {
                y: label.preferred-height + 1px;
                x: (parent.width - self.width) / 2;
                width: label.preferred-width;
                height: 1px;
                background: label.color;
            }
        }
    }
}
