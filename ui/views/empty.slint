import { Theme } from "../theme.slint";
import { View } from "../components/view.slint";

export component EmptyView inherits View {
    callback add-tape();

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        TouchArea {
            height: 260px;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.add-tape(); }

            Image {
                width: 320px;
                height: 243px;
                source: @image-url("../../assets/add-tape.svg");
            }
        }
        Text {
            text: "add a tape";
            horizontal-alignment: center;
            font-size: 24px;
            color: Theme.text;
        }
        Text {
            text: "no tapes yet";
            horizontal-alignment: center;
            font-size: 14px;
            color: Theme.text-muted;
        }
    }
}
