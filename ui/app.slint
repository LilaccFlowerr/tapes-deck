import { Theme } from "theme.slint";
import { EmptyView } from "views/empty.slint";
import { LibraryView, TapeInfo } from "views/library.slint";

export component AppWindow inherits Window {
    in property <[TapeInfo]> tapes;
    in property <int> active: -1;

    title: "tapesgui";
    preferred-width: 1100px;
    preferred-height: 700px;
    background: Theme.background;

    for i in Math.ceil(root.height / 34px): Rectangle {
        y: 30px + i * 34px;
        height: 1px;
        background: Theme.rule;
    }

    Rectangle {
        x: 18px;
        width: 1.5px;
        background: Theme.margin;
    }

    if root.tapes.length == 0: EmptyView { }

    if root.tapes.length > 0: LibraryView {
        tapes: root.tapes;
        active: root.active;
    }
}
