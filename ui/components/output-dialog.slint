import { Theme } from "../theme.slint";
import { Button } from "button.slint";
import { Dialog } from "dialog.slint";

export component OutputDialog inherits Dialog {
    in property <string> text;

    card-width: 720px;
    card-height: 520px;

    Text {
        text: "last output";
        font-family: Theme.font-hand;
        font-size: 34px;
        font-weight: 700;
        color: Theme.text;
    }

    output-view := Flickable {
        vertical-stretch: 1;
        content-height: output-text.preferred-height;

        output-text := Text {
            width: output-view.width;
            text: root.text;
            font-family: "JetBrains Mono";
            font-size: 12px;
            color: Theme.text.with-alpha(0.85);
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        alignment: end;

        Button {
            width: 110px;
            text: "close";
            clicked => { root.dismissed(); }
        }
    }
}
