import { Theme } from "../theme.slint";

export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text <=> input.text;

    callback accepted();

    alignment: start;
    spacing: 6px;

    Text {
        text: root.label;
        font-size: 12px;
        color: Theme.text-muted;
    }

    Rectangle {
        height: 40px;
        border-radius: 8px;
        background: Theme.background.with-alpha(0.6);
        border-width: 1px;
        border-color: input.has-focus ? Theme.text-muted : Theme.text-muted.with-alpha(0.25);

        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            font-size: 15px;
            color: Theme.text;
            accepted => { root.accepted(); }
        }

        if input.text == "": Text {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            vertical-alignment: center;
            text: root.placeholder;
            font-size: 15px;
            color: Theme.text-muted.with-alpha(0.5);
            overflow: elide;
        }
    }
}
