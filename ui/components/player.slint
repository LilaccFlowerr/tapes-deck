import { Cassette } from "cassette.slint";
import { Button } from "button.slint";

export component Player inherits Rectangle {
    in property <bool> loaded;
    in property <string> name;
    in property <string> subtitle;
    in property <string> side: "A";
    in property <color> marker;
    in property <bool> playing;
    in property <bool> busy;
    in property <bool> show-eject: true;

    callback eject();

    width: 520px;
    height: 442px;

    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../../assets/player.svg");
    }

    if root.loaded: Cassette {
        x: 60px;
        y: 113px;
        name: root.name;
        subtitle: root.subtitle;
        side: root.side;
        marker: root.marker;
        playing: root.playing;
    }

    if root.show-eject: Button {
        x: 344px;
        y: 30px;
        width: 132px;
        height: 44px;
        text: root.busy ? "busy…" : "⏏  eject";
        enabled: root.loaded && !root.busy;
        clicked => { root.eject(); }
    }
}
