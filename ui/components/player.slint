import { Cassette } from "cassette.slint";
import { Button } from "button.slint";

export component Player inherits Rectangle {
    in property <bool> loaded;
    in property <string> name;
    in property <string> subtitle;
    in property <string> side: "A";
    in property <color> marker;
    in property <bool> playing;
    in property <bool> busy;
    in property <bool> show-eject: true;
    // An ejecting tape is drawn by the library's flying ghost instead, from exactly this spot.
    in property <bool> handoff;

    callback eject();

    width: 520px;
    height: 442px;

    // The cassette is built once and only shown or hidden: inserting is the library's flying
    // ghost landing in the bay, so there is nothing to animate here.
    changed loaded => {
        if root.loaded {
            cassette.progress = 0.25;
        }
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../../assets/player.svg");
    }

    cassette := Cassette {
        x: 60px;
        y: 113px;
        visible: root.loaded && !root.handoff;
        name: root.name;
        subtitle: root.subtitle;
        side: root.side;
        marker: root.marker;
        playing: root.loaded && root.playing;
    }

    if root.show-eject: Button {
        x: 344px;
        y: 30px;
        width: 132px;
        height: 44px;
        text: root.busy ? "busy…" : "⏏  eject";
        enabled: root.loaded && !root.busy;
        clicked => { root.eject(); }
    }
}
